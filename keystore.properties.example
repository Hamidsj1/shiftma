# این فایل را به keystore.properties کپی کنید (کنار settings.gradle.kts) و مقدارها را پر کنید.
# keystore.properties و فایل .jks هرگز نباید جایی منتشر یا کامیت شوند و حتماً از آن‌ها نسخهٔ پشتیبان بگیرید:
# اگر کلید را گم کنید دیگر نمی‌توانید برنامه را در فروشگاه به‌روزرسانی کنید.
storeFile=shiftma-release.jks
storePassword=CHANGE_ME
keyAlias=shiftma
keyPassword=CHANGE_ME
